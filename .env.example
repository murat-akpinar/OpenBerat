# Real values go in .env, which is not committed.
# Every variable here is referenced by docker-compose.yml; leave one out and
# compose substitutes an empty string. How to generate each: INSTALL.md §3.
POSTGRES_PASSWORD=change-me
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=change-me
AD_DOMAIN=ad.example.local
AD_ADMIN_PASSWORD=Change-me-1
# The OIDC client secret. The committed realm export carries a ${OPENBERAT_CLIENT_SECRET}
# placeholder and Keycloak resolves it from its own environment at import.
OPENBERAT_CLIENT_SECRET=change-me
# Must decode to 16, 24 or 32 bytes or oauth2-proxy refuses to start:
#   openssl rand -base64 32 | tr -d '\n'
OAUTH2_PROXY_COOKIE_SECRET=change-me-to-32-bytes-base64
# Lab users only (labuser, labadmin). Gone once AD federation lands.
LAB_USER_PASSWORD=change-me
# ADMIN_GROUP (default OpenBerat-Admins, ADR-0008) arrives with the admin API
# in Phase 4; docker-compose.yml does not read it yet.
