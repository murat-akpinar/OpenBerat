# Real values go in .env, which is not committed.
# Every variable here is referenced by docker-compose.yml — except
# LAB_USER_PASSWORD, which only samba-ad/fixture.sh reads. Leave one out and
# compose substitutes an empty string. How to generate each: INSTALL.md §3.
# Goes into DATABASE_URL: a `/` in the password ends the authority component
# and the error names the port, not the password. INSTALL.md §3.
POSTGRES_PASSWORD=change-me
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=change-me
AD_DOMAIN=example.local
AD_ADMIN_PASSWORD=Change-me-1
# The OIDC client secret. The committed realm export carries a ${OPENBERAT_CLIENT_SECRET}
# placeholder and Keycloak resolves it from its own environment at import.
OPENBERAT_CLIENT_SECRET=change-me
# The second client secret: the backend's service account, used only for the
# kill switch's Keycloak step (ADR-0019). Same placeholder mechanism as above.
# Not the same value as OPENBERAT_CLIENT_SECRET — that one lives in
# oauth2-proxy, and sharing it would give oauth2-proxy `manage-users`.
OPENBERAT_BACKEND_SECRET=change-me
# 16, 24 or 32 bytes in the URL-safe alphabet, or oauth2-proxy refuses to
# start. Plain base64 is 44 characters and is refused. INSTALL.md §3.
#   openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=change-me-to-32-bytes-base64url
# The password Keycloak binds to AD with. The committed realm export carries an
# ${AD_BIND_PASSWORD} placeholder; the account itself is created by
# `samba-ad/fixture.sh`, which reads the same variable.
AD_BIND_PASSWORD=change-me
# The password every lab user in the AD fixture gets. Read by
# `samba-ad/fixture.sh` only — Keycloak no longer holds local users.
LAB_USER_PASSWORD=change-me
# The AD group that grants the management plane (ADR-0008). Leave it unset to
# take the default; point it anywhere if your AD has a fixed naming policy.
ADMIN_GROUP=OpenBerat-Admins
