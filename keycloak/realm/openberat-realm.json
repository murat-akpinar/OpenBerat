{
  "realm": "openberat",
  "enabled": true,
  "displayName": "OpenBerat",
  "sslRequired": "external",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "loginTheme": "openberat",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "browserFlow": "openberat-browser",
  "roles": {
    "realm": [
      {
        "name": "openberat-mfa",
        "description": "Carried by ADMIN_GROUP, not by users: the browser flow asks its holders for OTP (ADR-0032)."
      }
    ]
  },
  "groups": [
    {
      "name": "OpenBerat-Admins",
      "path": "/OpenBerat-Admins",
      "realmRoles": [
        "openberat-mfa"
      ]
    }
  ],
  "authenticationFlows": [
    {
      "alias": "openberat-browser",
      "description": "Browser login. Everything is stock except the last sub-flow: members of ADMIN_GROUP carry the openberat-mfa role and are asked for a second factor (ADR-0032).",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "identity-provider-redirector",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "openberat-forms",
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "autheticatorFlow": true,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "openberat-forms",
      "description": "Username and password, then whichever second factor applies.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "openberat-2fa-optional",
          "requirement": "CONDITIONAL",
          "priority": 20,
          "autheticatorFlow": true,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "openberat-admin-otp",
          "requirement": "CONDITIONAL",
          "priority": 30,
          "autheticatorFlow": true,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "openberat-2fa-optional",
      "description": "Everyone who is not an admin, exactly as a stock realm behaves: OTP is asked for only if the user has enrolled one. The negated role condition is what keeps an admin from being asked twice.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role",
          "authenticatorConfig": "not-an-admin",
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "conditional-user-configured",
          "requirement": "REQUIRED",
          "priority": 20,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "openberat-admin-otp",
      "description": "The management plane's second factor. REQUIRED rather than ALTERNATIVE: an admin with no OTP credential is sent to enrolment instead of past it.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role",
          "authenticatorConfig": "admins-otp",
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "requirement": "REQUIRED",
          "priority": 20,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "admins-otp",
      "config": {
        "condUserRole": "openberat-mfa"
      }
    },
    {
      "alias": "not-an-admin",
      "config": {
        "condUserRole": "openberat-mfa",
        "negate": "true"
      }
    }
  ],
  "clients": [
    {
      "clientId": "openberat-proxy",
      "name": "OpenBerat oauth2-proxy",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "secret": "${OPENBERAT_CLIENT_SECRET}",
      "redirectUris": [
        "https://portal.${APPS_DOMAIN}/oauth2/callback"
      ],
      "webOrigins": [
        "https://portal.${APPS_DOMAIN}"
      ],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "openberat-proxy",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "openberat-backend",
      "name": "OpenBerat backend (kill switch)",
      "description": "Service account for the ADR-0019 kill switch: logout-all only. No browser flow.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "${OPENBERAT_BACKEND_SECRET}",
      "redirectUris": [],
      "webOrigins": []
    }
  ],
  "components": {
    "org.keycloak.storage.UserStorageProvider": [
      {
        "name": "ad",
        "providerId": "ldap",
        "subComponents": {
          "org.keycloak.storage.ldap.mappers.LDAPStorageMapper": [
            {
              "name": "username",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "user.model.attribute": [
                  "username"
                ],
                "ldap.attribute": [
                  "sAMAccountName"
                ],
                "read.only": [
                  "true"
                ],
                "always.read.value.from.ldap": [
                  "false"
                ],
                "is.mandatory.in.ldap": [
                  "true"
                ]
              }
            },
            {
              "name": "first name",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "user.model.attribute": [
                  "firstName"
                ],
                "ldap.attribute": [
                  "givenName"
                ],
                "read.only": [
                  "true"
                ],
                "always.read.value.from.ldap": [
                  "true"
                ],
                "is.mandatory.in.ldap": [
                  "true"
                ]
              }
            },
            {
              "name": "last name",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "user.model.attribute": [
                  "lastName"
                ],
                "ldap.attribute": [
                  "sn"
                ],
                "read.only": [
                  "true"
                ],
                "always.read.value.from.ldap": [
                  "true"
                ],
                "is.mandatory.in.ldap": [
                  "true"
                ]
              }
            },
            {
              "name": "email",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "user.model.attribute": [
                  "email"
                ],
                "ldap.attribute": [
                  "mail"
                ],
                "read.only": [
                  "true"
                ],
                "always.read.value.from.ldap": [
                  "true"
                ],
                "is.mandatory.in.ldap": [
                  "false"
                ]
              }
            },
            {
              "name": "creation date",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "user.model.attribute": [
                  "createTimestamp"
                ],
                "ldap.attribute": [
                  "whenCreated"
                ],
                "read.only": [
                  "true"
                ],
                "always.read.value.from.ldap": [
                  "true"
                ],
                "is.mandatory.in.ldap": [
                  "false"
                ]
              }
            },
            {
              "name": "modify date",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "user.model.attribute": [
                  "modifyTimestamp"
                ],
                "ldap.attribute": [
                  "whenChanged"
                ],
                "read.only": [
                  "true"
                ],
                "always.read.value.from.ldap": [
                  "true"
                ],
                "is.mandatory.in.ldap": [
                  "false"
                ]
              }
            },
            {
              "name": "full name",
              "providerId": "full-name-ldap-mapper",
              "config": {
                "ldap.full.name.attribute": [
                  "cn"
                ],
                "read.only": [
                  "true"
                ],
                "write.only": [
                  "false"
                ]
              }
            },
            {
              "name": "openberat-groups",
              "providerId": "group-ldap-mapper",
              "config": {
                "groups.dn": [
                  "OU=Groups,DC=example,DC=local"
                ],
                "group.name.ldap.attribute": [
                  "cn"
                ],
                "group.object.classes": [
                  "group"
                ],
                "membership.ldap.attribute": [
                  "member"
                ],
                "membership.attribute.type": [
                  "DN"
                ],
                "membership.user.ldap.attribute": [
                  "sAMAccountName"
                ],
                "groups.ldap.filter": [
                  "(&(cn=OpenBerat-*)(!(cn=*,*)))"
                ],
                "mode": [
                  "READ_ONLY"
                ],
                "user.roles.retrieve.strategy": [
                  "GET_GROUPS_FROM_USER_MEMBEROF_ATTRIBUTE"
                ],
                "memberof.ldap.attribute": [
                  "memberOf"
                ],
                "preserve.group.inheritance": [
                  "false"
                ],
                "ignore.missing.groups": [
                  "true"
                ],
                "drop.non.existing.groups.during.sync": [
                  "false"
                ]
              }
            }
          ]
        },
        "config": {
          "enabled": [
            "true"
          ],
          "priority": [
            "0"
          ],
          "vendor": [
            "ad"
          ],
          "connectionUrl": [
            "ldaps://dc01.example.local:636"
          ],
          "authType": [
            "simple"
          ],
          "bindDn": [
            "CN=svc-keycloak,OU=Service Accounts,DC=example,DC=local"
          ],
          "bindCredential": [
            "${AD_BIND_PASSWORD}"
          ],
          "usersDn": [
            "OU=Users,DC=example,DC=local"
          ],
          "searchScope": [
            "2"
          ],
          "usernameLDAPAttribute": [
            "sAMAccountName"
          ],
          "rdnLDAPAttribute": [
            "cn"
          ],
          "uuidLDAPAttribute": [
            "objectGUID"
          ],
          "userObjectClasses": [
            "person, organizationalPerson, user"
          ],
          "customUserSearchFilter": [
            "(&(objectCategory=person)(objectClass=user)(!(userAccountControl:1.2.840.113556.1.4.803:=2)))"
          ],
          "editMode": [
            "READ_ONLY"
          ],
          "importEnabled": [
            "true"
          ],
          "syncRegistrations": [
            "false"
          ],
          "trustEmail": [
            "true"
          ],
          "cachePolicy": [
            "NO_CACHE"
          ],
          "useTruststoreSpi": [
            "always"
          ],
          "startTls": [
            "false"
          ],
          "connectionPooling": [
            "true"
          ],
          "pagination": [
            "true"
          ],
          "batchSizeForSync": [
            "1000"
          ],
          "fullSyncPeriod": [
            "-1"
          ],
          "changedSyncPeriod": [
            "-1"
          ]
        }
      }
    ]
  },
  "users": [
    {
      "username": "service-account-openberat-backend",
      "enabled": true,
      "serviceAccountClientId": "openberat-backend",
      "clientRoles": {
        "realm-management": [
          "manage-users"
        ]
      }
    }
  ]
}
